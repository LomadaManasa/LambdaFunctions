def identify_metric_type(alarm_name, alarm_description):
    # Implement logic to identify metric type from alarm name or description
    if 'cpu' in alarm_name.lower() or 'cpu' in alarm_description.lower():
        return 'cpu'
    elif 'memory' in alarm_name.lower() or 'memory' in alarm_description.lower():
        return 'memory'
    elif 'disk' in alarm_name.lower() or 'disk' in alarm_description.lower():
        return 'disk'
    else:
        return 'unknown'  # Default label if metric type cannot be determined

def add_to_current_sprint(issue_key):
    
    board_id=variables.board_id
    # Retrieve the current active sprint
    sprint_endpoint = f"{variables.jira_url}/rest/agile/1.0/board/{board_id}/sprint?state=active"
 
    jira_auth = (variables.jira_usermailId, variables.jira_ApiToken)
    response = requests.get(sprint_endpoint,auth=jira_auth)
    
    if response.status_code == 200:
        sprint_data = response.json()
        
        if sprint_data['values']:
            current_sprint_id = sprint_data['values'][0]['id']
            
            # Add the issue to the current sprint
            add_issue_to_sprint_endpoint = f"{variables.jira_url}/rest/agile/1.0/sprint/{current_sprint_id}/issue"
            payload = {
                "issues": [issue_key]
            }
            print(payload)
            response = requests.post(add_issue_to_sprint_endpoint, json=payload, auth=jira_auth)
            
            if response.status_code == 204:
                print("Issue added to the current sprint successfully")
            else:
                print("Failed to add issue to the current sprint:", response.text)
        else:
            print("No active sprint found")
    else:
        print("Failed to retrieve active sprint:", response.text)

def send_email(alarm_name,alarm_description,issue_key):
    client = boto3.client('sns')
    message = f"New Jira ticket has been created with the following details : \n Jira Ticket URL : {variables.jira_url}/jira/servicedesk/projects/{variables.ProjectKey}/queues/custom/1/{issue_key} \n Jira Ticket Number: {issue_key}\n Jira Ticket Summary: {alarm_name}, \n Jira Ticket Description :{alarm_description}"
    response = client.publish(TopicArn='arn:aws:sns:us-east-1:612572392212:Sample',Message=message,)
    print("Message published")
    return(response)
    
